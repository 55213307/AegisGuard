# Copy this file to .env and fill in real values. Never commit .env.
# Same database as admin/backend (company logins live on its `accounts` table).
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/aegisguard
# Must be different from admin/backend's JWT_SECRET_KEY.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
