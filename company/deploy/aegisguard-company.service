# systemd unit for the AegisGuard company portal.
# Install: sudo cp aegisguard-company.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now aegisguard-company

[Unit]
Description=AegisGuard Company Portal (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=aegisguard
Group=aegisguard
# Relative paths in the app (../frontend, ../../resources, .env) resolve from here.
WorkingDirectory=/opt/aegisguard/AegisGuard/company/backend
# Only reachable through Nginx on the same machine, never directly from outside.
ExecStart=/opt/aegisguard/AegisGuard/company/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
